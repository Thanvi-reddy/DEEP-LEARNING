import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.metrics import mean_squared_error

np.random.seed(42)

X = np.linspace(0, 10, 50).reshape(-1, 1)
y = np.sin(X).ravel() + np.random.normal(0, 0.2, 50)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

for degree in [1, 4, 15]:
    model = make_pipeline(
        PolynomialFeatures(degree),
        LinearRegression()
    )

    model.fit(X_train, y_train)

    train_error = mean_squared_error(
        y_train, model.predict(X_train)
    )
    test_error = mean_squared_error(
        y_test, model.predict(X_test)
    )

    print("\nPolynomial Degree:", degree)
    print("Training Error:", round(train_error, 4))
    print("Testing Error:", round(test_error, 4))

    X_line = np.linspace(0, 10, 200).reshape(-1, 1)

    plt.scatter(X_train, y_train, label="Training Data")
    plt.plot(X_line, model.predict(X_line), label="Model")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.title("Polynomial Degree " + str(degree))
    plt.legend()
    plt.show()
