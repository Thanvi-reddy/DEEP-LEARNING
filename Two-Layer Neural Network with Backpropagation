
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])
y = np.array([[0], [1], [1], [0]])

W1 = np.random.randn(2, 4)
b1 = np.zeros((1, 4))
W2 = np.random.randn(4, 1)
b2 = np.zeros((1, 1))

def sigmoid(x):
    return 1 / (1 + np.exp(-x))

learning_rate = 0.5
losses = []

for epoch in range(10000):
    hidden = np.tanh(np.dot(X, W1) + b1)
    output = sigmoid(np.dot(hidden, W2) + b2)

    error = output - y
    loss = np.mean(error ** 2)
    losses.append(loss)

    d_output = error * output * (1 - output)
    dW2 = np.dot(hidden.T, d_output) / len(X)
    db2 = np.mean(d_output, axis=0, keepdims=True)

    d_hidden = np.dot(d_output, W2.T) * (1 - hidden ** 2)
    dW1 = np.dot(X.T, d_hidden) / len(X)
    db1 = np.mean(d_hidden, axis=0, keepdims=True)

    W2 -= learning_rate * dW2
    b2 -= learning_rate * db2
    W1 -= learning_rate * dW1
    b1 -= learning_rate * db1

print("Final Loss:", round(losses[-1], 6))
print("\nPredictions:")
print(np.round(output, 3))
print("\nPredicted Classes:")
print((output >= 0.5).astype(int))

plt.plot(losses)
plt.title("Backpropagation: Training Loss")
plt.xlabel("Epoch")
plt.ylabel("Mean Squared Error")
plt.grid()
plt.show()
